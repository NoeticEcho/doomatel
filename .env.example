# ─────────────────────────────────────────────────────────────────────────────
# Doomatel — пример конфигурации.
# Скопируйте в `.env` и заполните. Файл `.env` в репозиторий не попадает.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development

# ── База данных ──────────────────────────────────────────────────────────────
# При работе с Supabase CLI (`supabase start`) значения берутся из его вывода.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Прямое подключение в обход пулера — нужно для миграций.
DIRECT_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# ── Supabase ─────────────────────────────────────────────────────────────────
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Секрет для проверки JWT на стороне NestJS.
SUPABASE_JWT_SECRET=

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Векторное хранилище ──────────────────────────────────────────────────────
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=doomatel_legal

# ── Очереди и кеш ────────────────────────────────────────────────────────────
REDIS_URL=redis://127.0.0.1:6379

# ── Объектное хранилище (S3-совместимое) ─────────────────────────────────────
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=ru-central-1
S3_BUCKET=doomatel-documents
S3_MEDIA_BUCKET=doomatel-media
S3_ACCESS_KEY_ID=doomatel
S3_SECRET_ACCESS_KEY=doomatel-secret
S3_FORCE_PATH_STYLE=true

# ── Языковые модели ──────────────────────────────────────────────────────────
# Слой моделей работает через OpenAI-совместимый протокол. Это позволяет
# подключить как размещённые в РФ сервисы (GigaChat, YandexGPT через
# соответствующие шлюзы), так и собственный инференс (vLLM, Ollama).
LLM_BASE_URL=http://127.0.0.1:8000/v1
LLM_API_KEY=
# Основная модель — для рассуждений и написания текстов.
LLM_MODEL=qwen3-32b-instruct
# Быстрая модель — для классификации, маршрутизации, извлечения.
LLM_MODEL_FAST=qwen3-8b-instruct
# Модель с длинным контекстом — для работы с полными текстами законов.
LLM_MODEL_LONG=qwen3-32b-instruct
LLM_MAX_TOKENS=8192
LLM_TEMPERATURE=0.2

# ── Эмбеддинги и переранжирование ────────────────────────────────────────────
EMBEDDINGS_BASE_URL=http://127.0.0.1:8001/v1
EMBEDDINGS_API_KEY=
# Основная модель эмбеддингов: 1024 измерения, контекст 8192 токена —
# статья целиком помещается в один чанк без разрезания. Apache-2.0.
EMBEDDINGS_MODEL=deepvk/USER-bge-m3
EMBEDDINGS_DIMENSIONS=1024
# Быстрая модель для подсказок в редакторе и первичного отбора кандидатов.
EMBEDDINGS_MODEL_FAST=deepvk/USER2-small
EMBEDDINGS_DIMENSIONS_FAST=256
RERANKER_URL=http://127.0.0.1:8002/rerank
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# ── Распознавание речи ───────────────────────────────────────────────────────
ASR_URL=http://127.0.0.1:8003
ASR_MODEL=gigaam-v2-rnnt
DIARIZATION_ENABLED=true

# ── Источники законодательства ───────────────────────────────────────────────
# Ключи ИС «Законотворчество»: http://api.duma.gov.ru/key-request
DUMA_API_KEY=
DUMA_APP_TOKEN=
DUMA_API_BASE_URL=http://api.duma.gov.ru
SOZD_BASE_URL=https://sozd.duma.gov.ru
PRAVO_BASE_URL=http://publication.pravo.gov.ru
# Прокси для ингеста, если источники недоступны напрямую.
INGEST_PROXY_URL=
# Запасной транспорт через Jina Reader (нужен, если СОЗД закрыт напрямую).
JINA_API_KEY=
INGEST_USE_JINA=false
# Минимальный интервал между запросами к одному хосту, мс.
INGEST_MIN_INTERVAL_MS=1000

# ── Сервисы приложения ───────────────────────────────────────────────────────
API_PORT=3001
API_URL=http://127.0.0.1:3001
NEXT_PUBLIC_API_URL=http://127.0.0.1:3001

AGENTS_PORT=3002
AGENTS_URL=http://127.0.0.1:3002

COLLAB_PORT=3003
COLLAB_URL=ws://127.0.0.1:3003
NEXT_PUBLIC_COLLAB_URL=ws://127.0.0.1:3003

WEB_PORT=3000

# ── Наблюдаемость ────────────────────────────────────────────────────────────
LANGFUSE_BASE_URL=http://127.0.0.1:3030
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
OTEL_EXPORTER_OTLP_ENDPOINT=

# ── Почта ────────────────────────────────────────────────────────────────────
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM=noreply@doomatel.local

# ── Безопасность ─────────────────────────────────────────────────────────────
# Секрет для подписи внутренних сервисных токенов (api ↔ agents ↔ collab).
INTERNAL_SERVICE_SECRET=change-me
# Разрешённые источники для CORS, через запятую.
CORS_ORIGINS=http://127.0.0.1:3000
