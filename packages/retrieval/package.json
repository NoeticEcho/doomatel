    "lint": "eslint src test"
  },
  "dependencies": {
    "@doomatel/legal": "workspace:*",
    "@qdrant/js-client-rest": "^1.19.0",
    "snowball-stemmers": "^0.6.0",
    "undici": "^8.10.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@doomatel/tsconfig": "workspace:*",
    "@types/node": "^22.19.1",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "module": "./dist/index.js"
}
