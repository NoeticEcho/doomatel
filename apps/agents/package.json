    "@mastra/mcp": "^1.17.0",
    "@mastra/memory": "^1.27.0",
    "@mastra/pg": "^1.21.0",
    "@mastra/qdrant": "^1.1.2",
    "@qdrant/js-client-rest": "^1.19.0",
    "undici": "^8.10.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@doomatel/tsconfig": "workspace:*",
    "@types/node": "^22.19.1",
    "tsup": "^8.5.1",
    "tsx": "^4.20.7",
    "typescript": "^6.0.3",
